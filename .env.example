# Copy to .env and fill in NEW credentials. Never commit .env.
SERVER_PORT=8080

# Generate a new Base64 secret with at least 32 random bytes.
JWT_SECRET=REPLACE_WITH_NEW_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=REPLACE_WITH_ROTATED_DATABASE_PASSWORD
DB_POOL_MAX=5
DB_POOL_MIN=1
JPA_SHOW_SQL=false

CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_NEW_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_NEW_API_SECRET

PAYMENT_BANK_ID=MB
PAYMENT_BANK_NAME=MB Bank
PAYMENT_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
PAYMENT_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
PAYMENT_QR_TEMPLATE=compact2
VIETQR_IMAGE_BASE_URL=https://img.vietqr.io/image
